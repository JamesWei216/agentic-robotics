{
  "llm": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "model_strong": "deepseek-v4-pro",
    "temperature": 0.2,
    "timeout_s": 180,
    "max_retries": 3
  },
  "runtime": {
    "python": "/home/wei/work/g05/GalaxeaVLA-main/.venv/bin/python",
    "libero_root": "/home/wei/work/g05/LIBERO-master",
    "suite": "libero_bolt",
    "n_seeds": 10,
    "max_repairs": 3,
    "task_timeout_s": 1200,
    "parallel_workers": 4
  },
  "safety": {
